# ========================================================
# Cyclic Recruitment Portal (CRP) - Environment Variables
# ========================================================

# Server Port (used in local development)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=production

# MongoDB Database Connection String
# For Local: mongodb://127.0.0.1:27017/cyclic_recruitment_portal
# For Vercel / Cloud: MongoDB Atlas connection URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/crp?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/crp?retryWrites=true&w=majority

# Secret key used for signing JWT tokens and session cookies
JWT_SECRET=crp_cyclic_recruitment_portal_jwt_secret_2026_super_key
SESSION_SECRET=crp_cyclic_recruitment_session_secret_2026_key
