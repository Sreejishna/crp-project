<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="py-5 text-center">
  <div class="container py-5">
    <div class="stat-icon bg-danger-subtle text-danger mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2.5rem; border-radius: 50%;">
      <i class="bi bi-x-octagon"></i>
    </div>
    <h1 class="display-4 fw-bold text-dark mb-2">500</h1>
    <h4 class="fw-semibold text-secondary mb-3">Internal Server Error</h4>
    <p class="text-muted mb-4"><%= typeof error !== 'undefined' ? error : 'An unexpected server error occurred while processing your request.' %></p>
    <a href="/" class="btn btn-crp-primary px-4 py-2">
      <i class="bi bi-house-door me-1"></i> Return to Homepage
    </a>
  </div>
</main>

<%- include('partials/footer') %>
