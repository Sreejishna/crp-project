<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-9">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h2 class="fw-bold text-dark mb-1">
              <i class="bi bi-person-lines-fill text-primary me-2"></i> Academic Profile
            </h2>
            <p class="text-muted small mb-0">Maintain your academic credentials and technical skills for automated eligibility checks</p>
          </div>
          <a href="/student/dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
          </a>
        </div>

        <div class="card card-crp p-4 p-md-5">
          <form action="/student/profile" method="POST">
            
            <!-- Read-only University Identifiers -->
            <div class="bg-light p-3 rounded mb-4 border">
              <div class="row g-3">
                <div class="col-md-4">
                  <small class="text-muted d-block">Student ID / USN</small>
                  <strong class="text-dark fs-6"><%= student ? student.studentId : '' %></strong>
                </div>
                <div class="col-md-4">
                  <small class="text-muted d-block">Academic Department</small>
                  <strong class="text-dark fs-6"><%= student && student.department ? student.department.name : 'MCA' %></strong>
                </div>
                <div class="col-md-4">
                  <small class="text-muted d-block">Institutional Email</small>
                  <strong class="text-dark fs-6"><%= student ? student.email : '' %></strong>
                </div>
              </div>
            </div>

            <!-- Editable Profile Fields -->
            <div class="row g-3">
              <div class="col-12">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-person me-1"></i> Personal & Contact Info
                </h6>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Full Name</label>
                <input type="text" class="form-control" name="name" required value="<%= student ? student.name : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Contact Phone</label>
                <input type="text" class="form-control" name="phone" value="<%= student ? student.phone : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">GitHub Profile URL</label>
                <input type="url" class="form-control" name="github" placeholder="https://github.com/username" value="<%= student ? student.github : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">LinkedIn Profile URL</label>
                <input type="url" class="form-control" name="linkedin" placeholder="https://linkedin.com/in/username" value="<%= student ? student.linkedin : '' %>">
              </div>

              <!-- Academic Cutoff Metrics -->
              <div class="col-12 mt-4">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-mortarboard me-1"></i> Academic Scores & Backlog Record
                </h6>
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Degree / Qualification</label>
                <input type="text" class="form-control" name="qualification" value="<%= student ? student.qualification : 'MCA' %>">
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Cumulative CGPA (0-10) *</label>
                <input type="number" step="0.01" min="0" max="10" class="form-control fw-bold text-primary" name="cgpa" required value="<%= student ? student.cgpa : 7.5 %>">
                <small class="text-muted">Directly tested against company minimum cutoff.</small>
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Active Backlogs Count *</label>
                <input type="number" min="0" class="form-control fw-bold text-danger" name="activeBacklogs" required value="<%= student ? student.activeBacklogs : 0 %>">
                <small class="text-muted">Must be ≤ allowed backlogs per drive.</small>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">10th Grade Percentage (%)</label>
                <input type="number" step="0.1" class="form-control" name="tenthPercentage" value="<%= student ? student.tenthPercentage : 75 %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">12th Grade / Diploma (%)</label>
                <input type="number" step="0.1" class="form-control" name="twelfthPercentage" value="<%= student ? student.twelfthPercentage : 75 %>">
              </div>

              <!-- Technical Skill Set -->
              <div class="col-12 mt-4">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-code-slash me-1"></i> Technical Skills (Comma-Separated)
                </h6>
                <input
                  type="text"
                  class="form-control"
                  name="skills"
                  value="<%= student && student.skills ? student.skills.join(', ') : '' %>"
                  placeholder="Java, Python, Data Structures, SQL, Node.js"
                >
                <small class="text-muted">Example: Java, Python, Data Structures & Algorithms, React, Node.js, MongoDB, SQL</small>
              </div>

              <div class="col-12 mt-4">
                <button type="submit" class="btn btn-crp-primary px-4 py-2">
                  <i class="bi bi-save me-1"></i> Save Changes
                </button>
              </div>
            </div>

          </form>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
