<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-10">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h2 class="fw-bold text-dark mb-1">
              <i class="bi bi-calendar-plus text-primary me-2"></i>
              <%= isEdit ? 'Edit Recruitment Drive' : 'Schedule Seasonal Recruitment Drive' %>
            </h2>
            <p class="text-muted small mb-0">Configure quarterly hiring window, academic cutoffs, compensation package, and selection stages</p>
          </div>
          <a href="/admin/drives" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Drives
          </a>
        </div>

        <div class="card card-crp p-4 p-md-5">
          <form action="<%= isEdit ? '/admin/drives/' + drive._id + '/edit' : '/admin/drives' %>" method="POST">
            <div class="row g-3">
              
              <!-- Company & Role -->
              <div class="col-12">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-building me-1"></i> Company Partner & Position
                </h6>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Recruiting Company *</label>
                <select class="form-select" name="company" required>
                  <option value="">-- Select Company --</option>
                  <% if (companies && companies.length > 0) { %>
                    <% companies.forEach(c => { %>
                      <option value="<%= c._id %>" <%= drive && drive.company && drive.company.toString() === c._id.toString() ? 'selected' : '' %>>
                        <%= c.name %> (<%= c.industry %>)
                      </option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Job Role / Designation *</label>
                <input type="text" class="form-control" name="jobRole" required placeholder="e.g. Software Development Engineer (SDE-1)" value="<%= drive ? drive.jobRole : '' %>">
              </div>

              <!-- Season & Dates -->
              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Hiring Season (Quarter) *</label>
                <select class="form-select" name="hiringSeason" required>
                  <option value="January–March" <%= drive && drive.hiringSeason === 'January–March' ? 'selected' : '' %>>January–March (Q1 Spring)</option>
                  <option value="April–June" <%= drive && drive.hiringSeason === 'April–June' ? 'selected' : '' %>>April–June (Q2 Summer)</option>
                  <option value="July–September" <%= drive && drive.hiringSeason === 'July–September' ? 'selected' : '' %>>July–September (Q3 Autumn Day-1)</option>
                  <option value="October–December" <%= drive && drive.hiringSeason === 'October–December' ? 'selected' : '' %>>October–December (Q4 Winter Dream)</option>
                </select>
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Recruitment Start Date *</label>
                <input type="date" class="form-control" name="startDate" required value="<%= drive && drive.startDate ? new Date(drive.startDate).toISOString().split('T')[0] : '' %>">
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Recruitment End Date *</label>
                <input type="date" class="form-control" name="endDate" required value="<%= drive && drive.endDate ? new Date(drive.endDate).toISOString().split('T')[0] : '' %>">
              </div>

              <!-- Compensation & Logistics -->
              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Salary Package / Stipend *</label>
                <input type="text" class="form-control fw-bold text-success" name="salary" required placeholder="e.g. 18 - 28 LPA or ₹80,000/month" value="<%= drive ? drive.salary : '' %>">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Total Open Vacancies</label>
                <input type="number" min="1" class="form-control" name="vacancies" value="<%= drive ? drive.vacancies : 15 %>">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Work Location</label>
                <input type="text" class="form-control" name="workLocation" placeholder="e.g. Bengaluru / Hyderabad" value="<%= drive ? drive.workLocation : 'Bengaluru' %>">
              </div>

              <div class="col-md-2">
                <label class="form-label small fw-semibold text-muted">Work Mode</label>
                <select class="form-select" name="workMode">
                  <option value="Hybrid" <%= drive && drive.workMode === 'Hybrid' ? 'selected' : '' %>>Hybrid</option>
                  <option value="On-site" <%= drive && drive.workMode === 'On-site' ? 'selected' : '' %>>On-site</option>
                  <option value="Remote" <%= drive && drive.workMode === 'Remote' ? 'selected' : '' %>>Remote</option>
                </select>
              </div>

              <!-- Academic Cutoffs -->
              <div class="col-12 mt-4">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-mortarboard me-1"></i> Academic Cutoff Criteria
                </h6>
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Minimum CGPA (0-10)</label>
                <input type="number" step="0.1" min="0" max="10" class="form-control fw-bold text-primary" name="minCgpa" value="<%= drive ? drive.minCgpa : 7.0 %>">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Maximum Active Backlogs</label>
                <input type="number" min="0" class="form-control fw-bold text-danger" name="maxBacklogs" value="<%= drive ? drive.maxBacklogs : 0 %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Target Qualifications</label>
                <input type="text" class="form-control" name="qualification" value="<%= drive ? drive.qualification : 'MCA, B.Tech CSE, ISE, ECE' %>">
              </div>

              <div class="col-12">
                <label class="form-label small fw-semibold text-muted">Eligible Departments (Check all applicable) *</label>
                <div class="d-flex flex-wrap gap-3 p-3 bg-light rounded border">
                  <% if (departments && departments.length > 0) { %>
                    <% departments.forEach(dept => { %>
                      <% 
                        const isChecked = drive && drive.eligibleDepartments && drive.eligibleDepartments.some(d => d.toString() === dept._id.toString());
                      %>
                      <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="eligibleDepartments" value="<%= dept._id %>" id="dept_<%= dept._id %>" <%= isChecked || !drive ? 'checked' : '' %>>
                        <label class="form-check-label fw-semibold" for="dept_<%= dept._id %>">
                          <%= dept.name %> (<%= dept.code %>)
                        </label>
                      </div>
                    <% }) %>
                  <% } %>
                </div>
              </div>

              <div class="col-12">
                <label class="form-label small fw-semibold text-muted">Required Technical Skills (Comma-separated)</label>
                <input type="text" class="form-control" name="requiredSkills" value="<%= drive && drive.requiredSkills ? drive.requiredSkills.join(', ') : 'Data Structures, Java, SQL, Cloud Architecture' %>">
              </div>

              <!-- Multi-Stage Interview Rounds -->
              <% if (!isEdit) { %>
                <div class="col-12 mt-4">
                  <h6 class="fw-bold text-primary border-bottom pb-2">
                    <i class="bi bi-diagram-3 me-1"></i> Multi-Stage Selection Rounds (Optional)
                  </h6>
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-muted">Round 1 Name</label>
                  <input type="text" class="form-control" name="round1_name" value="Online Assessment (OA)">
                  <input type="text" class="form-control mt-1 small" name="round1_desc" placeholder="Details (e.g. 2 Coding + Aptitude)">
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-muted">Round 2 Name</label>
                  <input type="text" class="form-control" name="round2_name" value="Technical Interview 1">
                  <input type="text" class="form-control mt-1 small" name="round2_desc" placeholder="Details (e.g. Live DSA & LLD)">
                </div>

                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-muted">Round 3 Name</label>
                  <input type="text" class="form-control" name="round3_name" value="Managerial & HR Round">
                  <input type="text" class="form-control mt-1 small" name="round3_desc" placeholder="Details (e.g. STAR evaluation)">
                </div>
              <% } %>

              <!-- Drive Status -->
              <div class="col-md-4 mt-4">
                <label class="form-label small fw-semibold text-muted">Drive Status</label>
                <select class="form-select" name="status">
                  <option value="Upcoming" <%= drive && drive.status === 'Upcoming' ? 'selected' : '' %>>Upcoming</option>
                  <option value="Active" <%= drive && drive.status === 'Active' ? 'selected' : '' %>>Active</option>
                  <option value="Closed" <%= drive && drive.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                </select>
              </div>

              <div class="col-12 mt-4">
                <button type="submit" class="btn btn-crp-primary px-4 py-2">
                  <i class="bi bi-check-circle me-1"></i>
                  <%= isEdit ? 'Update Recruitment Drive' : 'Publish Seasonal Drive' %>
                </button>
              </div>

            </div>
          </form>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
