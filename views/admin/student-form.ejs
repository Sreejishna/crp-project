<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        
        <div class="d-flex justify-content-between align-items-center mb-4">
          <div>
            <h2 class="fw-bold text-dark mb-1">
              <i class="bi bi-person-gear text-primary me-2"></i>
              <%= isEdit ? 'Edit Student Record' : 'Add New Student Record' %>
            </h2>
            <p class="text-muted small mb-0">Academic scores, eligibility parameters, and placement status</p>
          </div>
          <a href="/admin/students" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Students
          </a>
        </div>

        <div class="card card-crp p-4 p-md-5">
          <form action="<%= isEdit ? '/admin/students/' + student._id + '/edit' : '/admin/students' %>" method="POST">
            <div class="row g-3">
              
              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Full Name *</label>
                <input type="text" class="form-control" name="name" required value="<%= student ? student.name : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Student ID / USN *</label>
                <input type="text" class="form-control text-uppercase" name="studentId" required value="<%= student ? student.studentId : '' %>">
              </div>

              <% if (!isEdit) { %>
                <div class="col-md-6">
                  <label class="form-label small fw-semibold text-muted">Institutional Email *</label>
                  <input type="email" class="form-control" name="email" required placeholder="student@crp.edu" value="<%= student ? student.email : '' %>">
                  <small class="text-muted">Account password defaults to <code>student123</code></small>
                </div>
              <% } %>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Academic Department *</label>
                <select class="form-select" name="department" required>
                  <% if (departments && departments.length > 0) { %>
                    <% departments.forEach(dept => { %>
                      <option value="<%= dept._id %>" <%= student && student.department && (student.department._id ? student.department._id.toString() : student.department.toString()) === dept._id.toString() ? 'selected' : '' %>>
                        <%= dept.name %> (<%= dept.code %>)
                      </option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Degree / Qualification</label>
                <input type="text" class="form-control" name="qualification" value="<%= student ? student.qualification : 'MCA' %>">
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Current CGPA (0-10) *</label>
                <input type="number" step="0.01" min="0" max="10" class="form-control fw-bold text-primary" name="cgpa" required value="<%= student ? student.cgpa : 8.0 %>">
              </div>

              <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted">Active Backlogs *</label>
                <input type="number" min="0" class="form-control fw-bold text-danger" name="activeBacklogs" required value="<%= student ? student.activeBacklogs : 0 %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">10th Percentage (%)</label>
                <input type="number" step="0.1" class="form-control" name="tenthPercentage" value="<%= student ? student.tenthPercentage : 75 %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">12th Percentage (%)</label>
                <input type="number" step="0.1" class="form-control" name="twelfthPercentage" value="<%= student ? student.twelfthPercentage : 75 %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Placement Status</label>
                <select class="form-select" name="placementStatus">
                  <option value="Not Placed" <%= student && student.placementStatus === 'Not Placed' ? 'selected' : '' %>>Not Placed</option>
                  <option value="Placed" <%= student && student.placementStatus === 'Placed' ? 'selected' : '' %>>Placed</option>
                  <option value="Higher Studies" <%= student && student.placementStatus === 'Higher Studies' ? 'selected' : '' %>>Higher Studies</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Contact Phone</label>
                <input type="text" class="form-control" name="phone" value="<%= student ? student.phone : '+91 98765 00000' %>">
              </div>

              <div class="col-12">
                <label class="form-label small fw-semibold text-muted">Skills (Comma-separated)</label>
                <input type="text" class="form-control" name="skills" value="<%= student && student.skills ? (Array.isArray(student.skills) ? student.skills.join(', ') : student.skills) : 'Java, SQL, Data Structures' %>">
              </div>

              <div class="col-12 mt-4">
                <button type="submit" class="btn btn-crp-primary px-4 py-2">
                  <i class="bi bi-check-circle me-1"></i>
                  <%= isEdit ? 'Update Student Record' : 'Save Student' %>
                </button>
              </div>

            </div>
          </form>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
