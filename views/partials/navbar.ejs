<!-- Top Demo Bar for Reviewers & Project Evaluation -->
<div class="demo-banner text-center py-1">
  <div class="container d-flex justify-content-between align-items-center flex-wrap">
    <span>
      <i class="bi bi-mortarboard-fill me-1"></i> MCA Final Project: <strong>Cyclic Recruitment Portal (CRP)</strong>
    </span>
    <span class="d-none d-md-inline">
      <% if (!user) { %>
        Demo Logins: 
        <a href="/login" class="ms-1 me-2 fw-semibold"><i class="bi bi-shield-lock"></i> Admin</a> |
        <a href="/login" class="ms-2 me-2 fw-semibold"><i class="bi bi-building"></i> Dept (MCA)</a> |
        <a href="/login" class="ms-2 fw-semibold"><i class="bi bi-person-badge"></i> Student</a>
      <% } else { %>
        Logged in as: <strong><%= user.name %></strong> (<span class="badge bg-light text-primary text-uppercase"><%= user.role %></span>)
      <% } %>
    </span>
  </div>
</div>

