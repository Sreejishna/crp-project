<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-6 col-md-8">
        
        <!-- Demonstration Helper Box -->
        <div class="card bg-primary-subtle border-primary mb-4 shadow-sm">
          <div class="card-body p-3">
            <div class="d-flex align-items-center justify-content-between mb-2">
              <span class="fw-bold text-primary small">
                <i class="bi bi-magic me-1"></i> Quick 1-Click Demo Credentials:
              </span>
              <span class="badge bg-primary">Evaluation Mode</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <button type="button" class="btn btn-sm btn-outline-primary bg-white fw-semibold" onclick="fillDemoLogin('admin@crp.edu', 'admin123', 'admin')">
                <i class="bi bi-shield-lock me-1"></i> Admin
              </button>
              <button type="button" class="btn btn-sm btn-outline-info bg-white fw-semibold" onclick="fillDemoLogin('mca.coord@crp.edu', 'dept123', 'department')">
                <i class="bi bi-building me-1"></i> MCA Dept
              </button>
              <button type="button" class="btn btn-sm btn-outline-info bg-white fw-semibold" onclick="fillDemoLogin('cse.coord@crp.edu', 'dept123', 'department')">
                <i class="bi bi-building me-1"></i> CSE Dept
              </button>
              <button type="button" class="btn btn-sm btn-outline-success bg-white fw-semibold" onclick="fillDemoLogin('rahul.mca@crp.edu', 'student123', 'student')">
                <i class="bi bi-person me-1"></i> Student (Rahul - MCA)
              </button>
              <button type="button" class="btn btn-sm btn-outline-success bg-white fw-semibold" onclick="fillDemoLogin('priya.cse@crp.edu', 'student123', 'student')">
                <i class="bi bi-person me-1"></i> Student (Priya - CSE)
              </button>
            </div>
          </div>
        </div>

        <!-- Main Login Card -->
        <div class="card card-crp p-4 p-md-5" id="loginForm">
          <div class="text-center mb-4">
            <div class="stat-icon bg-primary text-white mx-auto mb-2 rounded-circle">
              <i class="bi bi-lock-fill fs-4"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1">Sign In to Portal</h3>
            <p class="text-muted small">Enter your credentials to access your placement dashboard</p>
          </div>

          <form action="/login" method="POST">
            <input type="hidden" name="expectedRole" id="expectedRole" value="">

            <div class="mb-3">
              <label for="loginEmail" class="form-label fw-semibold small text-muted">Institutional Email Address</label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                <input
                  type="email"
                  class="form-control"
                  id="loginEmail"
                  name="email"
                  placeholder="name@crp.edu"
                  required
                  autofocus
                >
              </div>
            </div>

            <div class="mb-4">
              <label for="loginPassword" class="form-label fw-semibold small text-muted">Account Password</label>
              <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-key"></i></span>
                <input
                  type="password"
                  class="form-control"
                  id="loginPassword"
                  name="password"
                  placeholder="••••••••"
                  required
                >
              </div>
            </div>

            <button type="submit" class="btn btn-crp-primary w-100 py-2 mb-3">
              <i class="bi bi-box-arrow-in-right me-1"></i> Access Dashboard
            </button>
          </form>

          <div class="text-center border-top pt-3">
            <p class="text-muted small mb-0">
              New student? 
              <a href="/register" class="text-primary fw-bold text-decoration-none">
                Register Student Profile
              </a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
