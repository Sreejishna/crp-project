<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main class="py-5">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        
        <div class="card card-crp p-4 p-md-5">
          <div class="text-center mb-4">
            <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-1 rounded-pill mb-2">
              <i class="bi bi-mortarboard me-1"></i> Student Enrollment
            </span>
            <h3 class="fw-bold text-dark mb-1">Create Student Placement Profile</h3>
            <p class="text-muted small">
              Register your academic metrics to verify eligibility against seasonal hiring company cutoffs
            </p>
          </div>

          <form action="/register" method="POST">
            <div class="row g-3">
              <!-- Personal Details -->
              <div class="col-12">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-person me-1"></i> Basic & Account Information
                </h6>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Full Name *</label>
                <input type="text" class="form-control" name="name" required placeholder="e.g. Rahul Sharma" value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Student ID / USN *</label>
                <input type="text" class="form-control text-uppercase" name="studentId" required placeholder="e.g. 1CR24MCA001" value="<%= typeof formData !== 'undefined' && formData.studentId ? formData.studentId : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">College Email Address *</label>
                <input type="email" class="form-control" name="email" required placeholder="e.g. rahul.mca@crp.edu" value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Contact Phone Number</label>
                <input type="text" class="form-control" name="phone" placeholder="+91 98765 43210" value="<%= typeof formData !== 'undefined' && formData.phone ? formData.phone : '' %>">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Password * (min 6 characters)</label>
                <input type="password" class="form-control" name="password" required placeholder="••••••••">
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Confirm Password *</label>
                <input type="password" class="form-control" name="confirmPassword" required placeholder="••••••••">
              </div>

              <!-- Academic Profile -->
              <div class="col-12 mt-4">
                <h6 class="fw-bold text-primary border-bottom pb-2">
                  <i class="bi bi-mortarboard me-1"></i> Academic Performance & Eligibility Metrics
                </h6>
              </div>

              <div class="col-md-6">
                <label class="form-label small fw-semibold text-muted">Academic Department *</label>
                <select class="form-select" name="department" required>
                  <option value="">-- Select Department --</option>
                  <% if (typeof departments !== 'undefined' && departments) { %>
                    <% departments.forEach(d => { %>
                      <option value="<%= d._id %>"><%= d.name %> (<%= d.code %>)</option>
                    <% }) %>
                  <% } %>
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Degree / Qualification</label>
                <select class="form-select" name="qualification">
                  <option value="MCA">MCA</option>
                  <option value="B.Tech CSE">B.Tech CSE</option>
                  <option value="B.Tech ISE">B.Tech ISE</option>
                  <option value="B.Tech ECE">B.Tech ECE</option>
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Graduation Batch</label>
                <input type="number" class="form-control" name="batch" value="2026">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Current CGPA (0-10) *</label>
                <input type="number" step="0.01" min="0" max="10" class="form-control" name="cgpa" required placeholder="8.50" value="<%= typeof formData !== 'undefined' && formData.cgpa ? formData.cgpa : '' %>">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">Active Backlogs *</label>
                <input type="number" min="0" class="form-control" name="activeBacklogs" required value="0">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">10th Grade Percentage</label>
                <input type="number" step="0.1" class="form-control" name="tenthPercentage" placeholder="85.0" value="80.0">
              </div>

              <div class="col-md-3">
                <label class="form-label small fw-semibold text-muted">12th / Diploma %</label>
                <input type="number" step="0.1" class="form-control" name="twelfthPercentage" placeholder="82.5" value="78.0">
              </div>

              <div class="col-12">
                <label class="form-label small fw-semibold text-muted">Key Technical Skills (Comma-separated)</label>
                <input type="text" class="form-control" name="skills" placeholder="e.g. Java, Python, Data Structures, SQL, Node.js" value="Java, Data Structures, SQL, JavaScript">
                <small class="text-muted">Used to match with company technical prerequisites.</small>
              </div>

              <div class="col-12 mt-4">
                <button type="submit" class="btn btn-crp-primary w-100 py-2">
                  <i class="bi bi-check-circle me-1"></i> Register Student Account
                </button>
              </div>
            </div>
          </form>

          <div class="text-center border-top mt-4 pt-3">
            <p class="text-muted small mb-0">
              Already have an account? 
              <a href="/login" class="text-primary fw-bold text-decoration-none">Sign In Here</a>
            </p>
          </div>
        </div>

      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
