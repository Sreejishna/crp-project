<%- include('partials/header') %>
<%- include('partials/navbar') %>
<%- include('partials/alerts') %>

<main>
  <!-- Hero Section -->
  <section class="hero-banner mb-5 text-center">
    <div class="container py-4">
      <div class="row justify-content-center">
        <div class="col-lg-9">
          <span class="badge bg-light text-primary fw-bold px-3 py-2 rounded-pill mb-3 shadow-sm">
            <i class="bi bi-clock-history me-1"></i> Campus Cyclic Recruitment System
          </span>
          <h1 class="display-5 fw-bold mb-3 text-white">
            Seasonal Hiring & Placement Intelligence Portal
          </h1>
          <p class="lead text-light mb-4 opacity-90">
            Empowering students with transparent company criteria, multi-stage interview rounds, cutoffs, salary packages, and curated preparation roadmaps across all four seasonal campus cycles.
          </p>
          <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a href="/companies" class="btn btn-light text-primary fw-bold px-4 py-2 shadow-sm">
              <i class="bi bi-search me-1"></i> Explore Seasonal Companies
            </a>
            <a href="/seasonal-calendar" class="btn btn-outline-light fw-bold px-4 py-2">
              <i class="bi bi-calendar3 me-1"></i> View Annual Hiring Calendar
            </a>
            <% if (!user) { %>
              <a href="/register" class="btn btn-warning text-dark fw-bold px-4 py-2 shadow-sm">
                <i class="bi bi-person-plus-fill me-1"></i> Register Student
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="container mb-5">
    <!-- Informational Architecture Alert -->
    <div class="info-principle-banner mb-5 shadow-sm">
      <div class="d-flex align-items-start gap-3">
        <i class="bi bi-info-circle-fill text-primary fs-3"></i>
        <div>
          <h6 class="fw-bold mb-1">Key Architectural Principle: Information & Placement Intelligence</h6>
          <p class="mb-0 text-muted">
            This portal is <strong>not</strong> an online job application submission board. It is an institution-wide <strong>seasonal recruitment information, eligibility verification, and department placement management system</strong>. Students view criteria and verify cutoffs before attending on-campus or offline drives.
          </p>
        </div>
      </div>
    </div>

    <!-- 4 Seasonal Hiring Cycles Overview -->
    <div class="row g-4 mb-5">
      <div class="col-12 text-center mb-2">
        <h3 class="fw-bold text-dark">The 4 Seasonal Campus Hiring Cycles</h3>
        <p class="text-muted">Structured around college semester timelines and national recruiting windows</p>
      </div>

      <!-- Q1 Cycle -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 card-crp border-0">
          <div class="card-body p-4 stat-card q1">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge badge-season-q1 fw-bold px-2 py-1">Q1 Cycle</span>
              <span class="text-muted small fw-semibold">Jan – Mar</span>
            </div>
            <h5 class="fw-bold mb-2 text-dark">Spring Internships & PPOs</h5>
            <p class="text-muted small mb-3">
              Fast-track 6-month product internships and Pre-Placement Offer (PPO) conversions for 8th sem MCA / B.Tech.
            </p>
            <div class="d-flex justify-content-between text-muted small border-top pt-2">
              <span>Target Roles:</span>
              <strong class="text-dark">SDE-1, Cloud</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Q2 Cycle -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 card-crp border-0">
          <div class="card-body p-4 stat-card q2">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge badge-season-q2 fw-bold px-2 py-1">Q2 Cycle</span>
              <span class="text-muted small fw-semibold">Apr – Jun</span>
            </div>
            <h5 class="fw-bold mb-2 text-dark">Summer Placements</h5>
            <p class="text-muted small mb-3">
              Specialized technology consulting, cloud analytics, and early product associate placement rounds.
            </p>
            <div class="d-flex justify-content-between text-muted small border-top pt-2">
              <span>Target Roles:</span>
              <strong class="text-dark">Consulting, Data</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Q3 Cycle -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 card-crp border-0">
          <div class="card-body p-4 stat-card q3">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge badge-season-q3 fw-bold px-2 py-1">Q3 Cycle</span>
              <span class="text-muted small fw-semibold">Jul – Sep</span>
            </div>
            <h5 class="fw-bold mb-2 text-dark">Autumn Mega Day-1 Drives</h5>
            <p class="text-muted small mb-3">
              Super Dream and Tier-1 flagship hiring. High-volume on-campus recruitment with premium compensation packages.
            </p>
            <div class="d-flex justify-content-between text-muted small border-top pt-2">
              <span>Target Roles:</span>
              <strong class="text-dark">Core Tech, FTE</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Q4 Cycle -->
      <div class="col-md-6 col-lg-3">
        <div class="card h-100 card-crp border-0">
          <div class="card-body p-4 stat-card q4">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="badge badge-season-q4 fw-bold px-2 py-1">Q4 Cycle</span>
              <span class="text-muted small fw-semibold">Oct – Dec</span>
            </div>
            <h5 class="fw-bold mb-2 text-dark">Winter Dream Drives</h5>
            <p class="text-muted small mb-3">
              Quantitative finance, algorithmic trading firms, and enterprise ERP leaders conducting niche assessments.
            </p>
            <div class="d-flex justify-content-between text-muted small border-top pt-2">
              <span>Target Roles:</span>
              <strong class="text-dark">Quant, ERP, Dev</strong>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Live Statistics & Metrics -->
    <div class="row g-4 mb-5">
      <div class="col-md-4">
        <div class="card card-crp text-center p-4">
          <div class="stat-icon bg-primary-subtle text-primary mx-auto mb-3">
            <i class="bi bi-buildings-fill fs-3"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark"><%= totalCompanies %>+</h2>
          <p class="text-muted mb-0">Registered Seasonal Companies</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card card-crp text-center p-4">
          <div class="stat-icon bg-success-subtle text-success mx-auto mb-3">
            <i class="bi bi-briefcase-fill fs-3"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark"><%= activeDrives %></h2>
          <p class="text-muted mb-0">Active Campus Recruitment Drives</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card card-crp text-center p-4">
          <div class="stat-icon bg-info-subtle text-info mx-auto mb-3">
            <i class="bi bi-calendar-check-fill fs-3"></i>
          </div>
          <h2 class="fw-bold mb-1 text-dark"><%= upcomingDrives %></h2>
          <p class="text-muted mb-0">Upcoming Seasonal Drives</p>
        </div>
      </div>
    </div>

    <!-- Featured Drives Grid -->
    <div class="row g-4 mb-5">
      <div class="col-12 d-flex justify-content-between align-items-center">
        <div>
          <h3 class="fw-bold text-dark mb-0">Featured Seasonal Hiring Drives</h3>
          <p class="text-muted small mb-0">Live criteria and compensation ranges</p>
        </div>
        <a href="/companies" class="btn btn-outline-primary btn-sm fw-semibold">
          View All Companies <i class="bi bi-arrow-right"></i>
        </a>
      </div>

      <% if (featuredDrives && featuredDrives.length > 0) { %>
        <% featuredDrives.forEach(drive => { %>
          <div class="col-md-6 col-lg-4">
            <div class="card card-crp h-100 p-3">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge <%= drive.seasonQuarter === 'Q1' ? 'badge-season-q1' : drive.seasonQuarter === 'Q2' ? 'badge-season-q2' : drive.seasonQuarter === 'Q3' ? 'badge-season-q3' : 'badge-season-q4' %>">
                  <%= drive.hiringSeason %>
                </span>
                <span class="badge <%= drive.status === 'Active' ? 'badge-status-active' : 'badge-status-upcoming' %>">
                  <%= drive.status %>
                </span>
              </div>
              <h5 class="fw-bold text-dark mb-1"><%= drive.company ? drive.company.name : 'Company' %></h5>
              <p class="text-primary fw-semibold small mb-2"><i class="bi bi-award me-1"></i> <%= drive.jobRole %></p>
              
              <ul class="list-unstyled small text-muted mb-3">
                <li class="mb-1"><i class="bi bi-cash-stack text-success me-2"></i> Package: <strong class="text-dark"><%= drive.salary %></strong></li>
                <li class="mb-1"><i class="bi bi-mortarboard text-secondary me-2"></i> Cutoff: <strong><%= drive.minCgpa %> CGPA</strong> | Max <%= drive.maxBacklogs %> Backlogs</li>
                <li class="mb-1"><i class="bi bi-geo-alt text-secondary me-2"></i> Location: <%= drive.workLocation %> (<%= drive.workMode %>)</li>
              </ul>

              <div class="mt-auto pt-2 border-top">
                <a href="/companies/<%= drive.company ? drive.company._id : '#' %>" class="btn btn-crp-outline btn-sm w-100">
                  <i class="bi bi-eye me-1"></i> View Eligibility & Interview Stages
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12">
          <div class="alert alert-light border text-center py-4">
            <i class="bi bi-calendar-x fs-2 text-muted d-block mb-2"></i>
            No active seasonal drives recorded yet.
          </div>
        </div>
      <% } %>
    </div>

    <!-- 3 Dedicated Modules Presentation -->
    <div class="row g-4 mb-4">
      <div class="col-12 text-center mb-2">
        <h3 class="fw-bold text-dark">Three Institutional Portals in One System</h3>
        <p class="text-muted">Role-based workspaces designed for college placement management</p>
      </div>

      <div class="col-md-4">
        <div class="card card-crp h-100 p-4 border-top border-4 border-primary">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="stat-icon bg-primary text-white rounded">
              <i class="bi bi-mortarboard fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">1. Student Module</h5>
              <small class="text-muted">Placement & Intelligence</small>
            </div>
          </div>
          <ul class="text-muted small ps-3 mb-4">
            <li>Verify profile against live company cutoffs</li>
            <li>Explore multi-stage interview rounds & OA tips</li>
            <li>Follow weekly curated preparation roadmaps</li>
            <li>Read central & department-specific notices</li>
          </ul>
          <div class="mt-auto">
            <a href="/login" class="btn btn-outline-primary btn-sm w-100 fw-semibold">
              <i class="bi bi-box-arrow-in-right me-1"></i> Student Login
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card card-crp h-100 p-4 border-top border-4 border-info">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="stat-icon bg-info text-white rounded">
              <i class="bi bi-building fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">2. Department Module</h5>
              <small class="text-muted">Coordinators & HODs</small>
            </div>
          </div>
          <ul class="text-muted small ps-3 mb-4">
            <li>Department student roster & live CGPA tracking</li>
            <li>Dynamic eligible student matcher for any drive</li>
            <li>Track placed candidates and CTC packages</li>
            <li>Analyze department placement percentages</li>
          </ul>
          <div class="mt-auto">
            <a href="/login" class="btn btn-outline-info btn-sm w-100 fw-semibold">
              <i class="bi bi-box-arrow-in-right me-1"></i> Coordinator Login
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card card-crp h-100 p-4 border-top border-4 border-dark">
          <div class="d-flex align-items-center gap-3 mb-3">
            <div class="stat-icon bg-dark text-white rounded">
              <i class="bi bi-shield-lock fs-4"></i>
            </div>
            <div>
              <h5 class="fw-bold mb-0">3. Admin Module</h5>
              <small class="text-muted">Placement Cell Officers</small>
            </div>
          </div>
          <ul class="text-muted small ps-3 mb-4">
            <li>Full CRUD on Companies & Recruitment Drives</li>
            <li>Schedule seasonal drives with round details</li>
            <li>Manage college-wide students and departments</li>
            <li>Publish priority announcements & view reports</li>
          </ul>
          <div class="mt-auto">
            <a href="/login" class="btn btn-outline-dark btn-sm w-100 fw-semibold">
              <i class="bi bi-box-arrow-in-right me-1"></i> Admin Login
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
