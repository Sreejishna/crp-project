                    <td>
                      <small class="text-muted d-block">Start: <%= new Date(drive.startDate).toLocaleDateString() %></small>
                      <small class="text-muted d-block">End: <%= new Date(drive.endDate).toLocaleDateString() %></small>
                    </td>
                    <td>
                      <span class="badge <%= drive.status === 'Active' ? 'badge-status-active' : drive.status === 'Upcoming' ? 'badge-status-upcoming' : 'badge-status-closed' %>">
                        <%= drive.status %>
                      </span>
                    </td>
                    <td>
                      <a href="/companies/<%= drive.company ? drive.company._id : '#' %>" class="btn btn-outline-primary btn-sm">
                        View Details
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="7" class="text-center py-4 text-muted">No Q2 drives scheduled yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Q3 PANE -->
      <div class="tab-pane fade" id="q3-pane" role="tabpanel">
        <div class="card card-crp p-4 mb-4 border-start border-4 border-warning">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
              <h4 class="fw-bold mb-1 text-dark">Q3 Cycle: Autumn Mega Campus Day-1 Drives</h4>
              <span class="text-muted small">Months: July to September | Core Target: Super Dream & Enterprise Tier-1 FTE</span>
            </div>
            <span class="badge badge-season-q3 fs-6 px-3 py-2">Quarter 3 Flagship</span>
          </div>
          <p class="text-muted small mb-0">
            The peak campus recruitment season featuring Day-1 premier recruiters and massive IT services digital / prime tracks.
          </p>
        </div>

        <div class="table-responsive bg-white rounded border shadow-sm">
          <table class="table table-hover table-crp mb-0">
            <thead>
              <tr>
                <th>Company</th>
                <th>Role & Location</th>
                <th>Salary / Stipend</th>
                <th>Cutoff (CGPA)</th>
                <th>Recruitment Window</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% if (q3Drives && q3Drives.length > 0) { %>
