      <div class="tab-pane fade" id="q4-pane" role="tabpanel">
        <div class="card card-crp p-4 mb-4 border-start border-4 border-purple">
          <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div>
              <h4 class="fw-bold mb-1 text-dark">Q4 Cycle: Winter Dream Drives & Core Tech</h4>
              <span class="text-muted small">Months: October to December | Core Target: FinTech, Quant Engineering & ERP Core</span>
            </div>
            <span class="badge badge-season-q4 fs-6 px-3 py-2">Quarter 4</span>
          </div>
          <p class="text-muted small mb-0">
            Specialized engineering assessments focused on algorithmic problem solving, financial analytics, and distributed cloud computing.
          </p>
        </div>

        <div class="table-responsive bg-white rounded border shadow-sm">
          <table class="table table-hover table-crp mb-0">
            <thead>
              <tr>
