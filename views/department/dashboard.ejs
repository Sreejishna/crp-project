<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-5">
  <div class="container">
    <!-- Department Header Banner -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <div>
        <span class="badge bg-info-subtle text-info-emphasis fw-bold px-3 py-1 rounded-pill mb-2">
          <i class="bi bi-building me-1"></i> Department Placement Officer
        </span>
        <h2 class="fw-bold text-dark mb-1"><%= department.name %> (<%= department.code %>)</h2>
        <p class="text-muted small mb-0">
          HOD: <strong><%= department.hodName %></strong> (<%= department.hodEmail %>) | Phone: <strong><%= department.hodPhone %></strong>
        </p>
      </div>
      <div class="d-flex gap-2">
        <a href="/department/students" class="btn btn-outline-primary btn-sm fw-semibold">
          <i class="bi bi-people me-1"></i> Student Roster
        </a>
        <a href="/department/statistics" class="btn btn-crp-primary btn-sm fw-semibold">
          <i class="bi bi-pie-chart me-1"></i> Placement Analytics
        </a>
      </div>
    </div>

    <!-- 4 Department Metric Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-muted small fw-semibold">Total Dept Students</span>
              <h3 class="fw-bold text-dark mb-0 mt-1"><%= totalStudents %></h3>
            </div>
            <div class="stat-icon bg-primary-subtle text-primary">
              <i class="bi bi-people-fill"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-muted small fw-semibold">Students Placed</span>
              <h3 class="fw-bold text-success mb-0 mt-1"><%= placedStudents %></h3>
            </div>
            <div class="stat-icon bg-success-subtle text-success">
              <i class="bi bi-trophy-fill"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-muted small fw-semibold">Placement Rate</span>
              <h3 class="fw-bold text-info mb-0 mt-1">
                <%= totalStudents > 0 ? ((placedStudents / totalStudents) * 100).toFixed(1) : 0 %>%
              </h3>
            </div>
            <div class="stat-icon bg-info-subtle text-info">
              <i class="bi bi-graph-up-arrow"></i>
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-3">
        <div class="stat-card">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <span class="text-muted small fw-semibold">Eligible Drives</span>
              <h3 class="fw-bold text-warning-emphasis mb-0 mt-1"><%= upcomingDrivesCount %></h3>
            </div>
            <div class="stat-icon bg-warning-subtle text-warning">
              <i class="bi bi-briefcase-fill"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Grid: Eligible Drives & Placed Students -->
    <div class="row g-4">
      <!-- Drives Column -->
      <div class="col-lg-7">
        <div class="card card-crp p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
              <i class="bi bi-calendar-check text-primary me-2"></i> Upcoming Drives Eligible for <%= department.code %>
            </h5>
            <a href="/department/drives" class="btn btn-outline-primary btn-sm fw-semibold">
              View All Drives
            </a>
          </div>

          <% if (upcomingDrives && upcomingDrives.length > 0) { %>
            <div class="d-flex flex-column gap-3">
              <% upcomingDrives.forEach(drive => { %>
                <div class="border rounded p-3 bg-light-subtle">
                  <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                      <h6 class="fw-bold text-dark mb-0"><%= drive.company ? drive.company.name : 'Company' %></h6>
                      <span class="text-primary small fw-semibold"><%= drive.jobRole %></span>
                    </div>
                    <span class="badge <%= drive.seasonQuarter === 'Q1' ? 'badge-season-q1' : drive.seasonQuarter === 'Q2' ? 'badge-season-q2' : drive.seasonQuarter === 'Q3' ? 'badge-season-q3' : 'badge-season-q4' %>">
                      <%= drive.hiringSeason %>
                    </span>
                  </div>
                  <div class="d-flex justify-content-between align-items-center small text-muted border-top pt-2">
                    <span>Cutoff: <strong><%= drive.minCgpa %> CGPA</strong></span>
                    <span>Package: <strong class="text-success"><%= drive.salary %></strong></span>
                    <span>Start: <%= new Date(drive.startDate).toLocaleDateString() %></span>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-muted small text-center py-4">No eligible drives scheduled at this time.</p>
          <% } %>
        </div>
      </div>

      <!-- Placements Column -->
      <div class="col-lg-5">
        <div class="card card-crp p-4 h-100">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
              <i class="bi bi-award-fill text-warning me-2"></i> Recent Placed Candidates
            </h5>
            <a href="/department/placements" class="btn btn-outline-secondary btn-sm fw-semibold">
              All Placements
            </a>
          </div>

          <% if (deptPlacements && deptPlacements.length > 0) { %>
            <div class="d-flex flex-column gap-3">
              <% deptPlacements.forEach(rec => { %>
                <div class="border rounded p-3 d-flex justify-content-between align-items-center">
                  <div>
                    <strong class="text-dark d-block"><%= rec.student ? rec.student.name : 'Student' %></strong>
                    <small class="text-muted"><%= rec.student ? rec.student.studentId : '' %> | <%= rec.jobRole %></small>
                    <small class="d-block text-secondary"><%= rec.company ? rec.company.name : '' %></small>
                  </div>
                  <div class="text-end">
                    <span class="badge bg-success-subtle text-success fs-6 fw-bold"><%= rec.package %></span>
                    <small class="d-block text-muted" style="font-size: 0.75rem;"><%= new Date(rec.placedDate).toLocaleDateString() %></small>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p class="text-muted small text-center py-4">No placement records recorded for this department yet.</p>
          <% } %>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
