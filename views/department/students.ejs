<%- include('../partials/header') %>
<%- include('../partials/navbar') %>
<%- include('../partials/alerts') %>

<main class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <div>
        <h2 class="fw-bold text-dark mb-1">
          <i class="bi bi-people text-primary me-2"></i> <%= department.code %> Department Students Roster
        </h2>
        <p class="text-muted small mb-0">Total Enrolled Students: <strong><%= students.length %></strong></p>
      </div>
      <a href="/department/dashboard" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
      </a>
    </div>

    <!-- Filter & Search Bar -->
    <div class="card card-crp p-3 mb-4">
      <form action="/department/students" method="GET" class="row g-2 align-items-center">
        <div class="col-md-7">
          <div class="input-group">
            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
            <input
              type="text"
              class="form-control"
              name="search"
              placeholder="Search by student name, ID, email, or skill..."
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            >
          </div>
        </div>

        <div class="col-md-3">
          <select class="form-select" name="status" onchange="this.form.submit()">
            <option value="All" <%= selectedStatus === 'All' ? 'selected' : '' %>>-- All Placement Statuses --</option>
            <option value="Placed" <%= selectedStatus === 'Placed' ? 'selected' : '' %>>Placed</option>
            <option value="Not Placed" <%= selectedStatus === 'Not Placed' ? 'selected' : '' %>>Not Placed</option>
          </select>
        </div>

        <div class="col-md-2">
          <button type="submit" class="btn btn-crp-primary w-100">
            <i class="bi bi-filter me-1"></i> Filter
          </button>
        </div>
      </form>
    </div>

    <!-- Student Roster Table -->
    <div class="table-responsive bg-white rounded border shadow-sm">
      <table class="table table-hover table-crp align-middle mb-0">
        <thead>
          <tr>
            <th>Student ID / USN</th>
            <th>Name & Contact</th>
            <th>Qualification / Batch</th>
            <th>CGPA (0-10)</th>
            <th>Active Backlogs</th>
            <th>Skills</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% if (students && students.length > 0) { %>
            <% students.forEach(s => { %>
              <tr>
                <td><strong class="text-dark"><%= s.studentId %></strong></td>
                <td>
                  <div class="fw-semibold text-dark"><%= s.name %></div>
                  <small class="text-muted"><%= s.email %></small>
                </td>
                <td><%= s.qualification %> (<%= s.batch %>)</td>
                <td><strong class="text-primary"><%= s.cgpa.toFixed(2) %></strong></td>
                <td>
                  <% if (s.activeBacklogs === 0) { %>
                    <span class="badge bg-success-subtle text-success">0 (Clean)</span>
                  <% } else { %>
                    <span class="badge bg-danger-subtle text-danger"><%= s.activeBacklogs %> Backlog(s)</span>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex flex-wrap gap-1" style="max-width: 250px;">
                    <% s.skills.forEach(skill => { %>
                      <span class="badge bg-light text-dark border small" style="font-size: 0.72rem;"><%= skill %></span>
                    <% }) %>
                  </div>
                </td>
                <td>
                  <span class="badge <%= s.placementStatus === 'Placed' ? 'bg-success' : 'bg-secondary' %>">
                    <%= s.placementStatus %>
                  </span>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <i class="bi bi-people fs-2 d-block mb-2"></i>
                No student records found matching this criteria.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
